      "PowerShell(git -c safe.directory=D:/Proyectos/Juegos/ourlife diff *)",
      "PowerShell(git -c safe.directory=D:/Proyectos/Juegos/ourlife branch)",
      "PowerShell(git -c safe.directory=D:/Proyectos/Juegos/ourlife branch --show-current)",
      "PowerShell(git -c safe.directory=D:/Proyectos/Juegos/ourlife branch --list *)",
      "PowerShell(git status *)",
      "PowerShell(git log *)",
      "PowerShell(git diff *)",
      "PowerShell(git branch)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch --list *)"
    ]
