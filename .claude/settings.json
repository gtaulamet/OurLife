      "Bash(git -c safe.directory=D:/Proyectos/Juegos/ourlife branch --list *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet restore *)",
      "PowerShell(& $env:GODOT_BIN *)",
      "PowerShell(git -c safe.directory=D:/Proyectos/Juegos/ourlife status *)",
