<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the real game content: defs and texts together, plus the code that uses them. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="OurLife.Tests.Shared" />
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\RepoPaths.cs" Link="Shared\RepoPaths.cs" />
    <!-- The game's catalog loader has no Godot dependency: the tests run the real one. -->
    <Compile Include="..\..\game\src\Content\LocaleCatalogs.cs" Link="Game\LocaleCatalogs.cs" />
    <!-- So is the visual catalog (ADR-009). -->
    <Compile Include="..\..\game\src\Rendering\VisualCatalog.cs" Link="Game\VisualCatalog.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OurLife.Core\OurLife.Core.csproj" />
    <ProjectReference Include="..\..\src\OurLife.Localization\OurLife.Localization.csproj" />
  </ItemGroup>

</Project>
